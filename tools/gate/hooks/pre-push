#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
head=$(git rev-parse HEAD)
check=no
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  if [ "$local_sha" = "$head" ]; then
    check=yes
  else
    echo "pre-push: $local_ref is not the checked-out HEAD, so this hook does not check it"
  fi
done
[ "$check" = yes ] || exit 0
exec bash tools/verify --changed
