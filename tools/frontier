"""What the tracker holds open, what waits and on what, and what is already in flight.

Python 3.11 stdlib only. Run as `python3 -I tools/frontier [--in-flight | --selftest]`; it finds the repo from its
own path.

    (no flag)     the frontier: open and ready-for-agent tickets whose blockers are all resolved, by effort and
                  number, so first by number wins. Then the blocked tickets and what blocks each, the claimed and
                  ready-for-human tickets, and any whose Status line is missing or names another status
    --in-flight   also the open pull requests, the frontier tickets their titles or changed paths name, and the
                  worktrees with uncommitted paths or an open pull request
    --selftest    every Blocked by shape, a ticket with no Status line, and a failing gh, on a synthetic tracker

A ticket is `.scratch/<effort>/issues/<NN>-<slug>.md`, and its Status, Type, Claimed by and Blocked by lines are the
ones before its first `## ` heading. A Blocked by line is `none`, `None (...)`, or a comma-separated list of ticket
numbers in the ticket's own effort and of paths to tickets, backticked or not, from the repo root or from the
ticket's directory. A ticket with no such line waits on nothing. A blocker is met only when the ticket it names has
`Status: resolved`, and a line in any other shape names no ticket and blocks.

Exit codes: 0 printed; 1 a selftest case failed; 2 a wrong usage or an unreadable ticket, or git or gh failed, in
which case the rest still prints.
"""

from __future__ import annotations

import dataclasses
import json
import os
import pathlib
import posixpath
import re
import subprocess
import sys
import tempfile
from collections.abc import Mapping, Sequence

ROOT = pathlib.Path(__file__).resolve().parents[1]
REPO = "ShanesNotes/nightingale"
GH = ("gh",)
START = ("open", "ready-for-agent")
CLOSED = ("resolved", "out-of-scope", "wontfix")
PATH = re.compile(r"[\w.-]+(?:/[\w.-]+)*\.md")
TITLES = {
    "frontier": "Frontier: open or ready-for-agent with every blocker resolved; first by number wins",
    "blocked": "Blocked: open or ready-for-agent, waiting on a ticket that is not resolved",
    "claimed": "Claimed",
    "human": "Ready for human",
    "other": "Other: no Status line, or a status this tool does not group",
}


@dataclasses.dataclass(frozen=True)
class Ticket:
    path: str
    effort: str
    number: str
    status: str | None
    kind: str
    claimed_by: str
    blocked_by: str | None

    @property
    def name(self) -> str:
        return f"{self.effort} {self.number}" if self.number else self.path

    @property
    def shown(self) -> str:
        return ", ".join(x for x in (self.status or "no Status line", self.kind) if x)


@dataclasses.dataclass(frozen=True)
class Wait:
    what: str
    met: bool


@dataclasses.dataclass(frozen=True)
class Pull:
    number: int
    title: str
    branch: str
    draft: bool
    files: frozenset[str]

    @property
    def name(self) -> str:
        return f"{REPO.split('/')[1]}#{self.number}" + (" (draft)" if self.draft else "")

    def names(self, t: Ticket) -> bool:
        effort = r"[-\s]+".join(map(re.escape, t.effort.split("-")))
        title = t.number and re.search(rf"\b{effort}\s+(?:tickets?\s+)?0*{int(t.number)}\b", self.title, re.I)
        return t.path in self.files or bool(title)


def field(head: str, label: str) -> str | None:
    m = re.search(rf"^{label}:[ \t]*(.*)$", head, re.M | re.I)
    return m.group(1).strip() if m else None


def load(root: pathlib.Path) -> dict[str, Ticket]:
    tickets = []
    for f in root.glob(".scratch/*/issues/*.md"):
        head = re.split(r"^## ", f.read_text(encoding="utf-8"), maxsplit=1, flags=re.M)[0]
        number = re.match(r"\d*", f.name).group(0)
        tickets.append(Ticket(
            path=f.relative_to(root).as_posix(),
            effort=f.parent.parent.name,
            number=number,
            status=re.match(r"[a-z-]*", (field(head, "Status") or "").lower()).group(0) or None,
            kind=(field(head, "Type") or "").partition(" ")[0],
            claimed_by=field(head, "Claimed by") or "",
            blocked_by=field(head, "Blocked by"),
        ))
    tickets.sort(key=lambda t: (t.effort, int(t.number or -1), t.path))
    return {t.path: t for t in tickets}


def on(u: Ticket) -> Wait:
    return Wait(f"{u.name} ({u.status or 'no Status line'})", u.status == "resolved")


def waits(t: Ticket, tickets: Mapping[str, Ticket]) -> list[Wait]:
    line = t.blocked_by or "none"
    if re.match(r"none\b", line, re.I):
        return []
    out = []
    for token in (part.strip().strip("`") for part in line.split(",")):
        if re.fullmatch(r"[0-9]+", token):
            named = [u for u in tickets.values() if u.effort == t.effort and u.number and int(u.number) == int(token)]
            out += [on(u) for u in named] or [Wait(f"{t.effort} {token} (no such ticket)", False)]
        elif PATH.fullmatch(token):
            base = "" if token.startswith(".scratch/") else posixpath.dirname(t.path)
            path = posixpath.normpath(posixpath.join(base, token))
            out.append(on(tickets[path]) if path in tickets else Wait(f"{token} (no such ticket)", False))
        else:
            return [Wait(f"a Blocked by line that names no ticket: {line}", False)]
    return out


def classify(tickets: Mapping[str, Ticket]) -> dict[str, list[tuple[Ticket, list[str]]]]:
    groups: dict[str, list[tuple[Ticket, list[str]]]] = {key: [] for key in TITLES}
    for t in tickets.values():
        if t.status in START:
            unmet = [f"waits on {w.what}" for w in waits(t, tickets) if not w.met]
            groups["blocked" if unmet else "frontier"].append((t, unmet))
        elif t.status == "claimed":
            groups["claimed"].append((t, [f"claimed by {t.claimed_by}"] if t.claimed_by else []))
        elif t.status == "ready-for-human":
            groups["human"].append((t, []))
        elif t.status not in CLOSED:
            groups["other"].append((t, []))
    return groups


def open_pulls(gh: Sequence[str]) -> tuple[list[Pull], str | None]:
    fields = "number,title,headRefName,isDraft,files"
    argv = [*gh, "pr", "list", "--repo", REPO, "--state", "open", "--limit", "200", "--json", fields]
    try:
        # Inside a checkout whose directory-scoped config empties gh's token, gh prints nothing and exits 0.
        r = subprocess.run(argv, capture_output=True, text=True, cwd=tempfile.gettempdir(), timeout=120)
    except (OSError, subprocess.TimeoutExpired) as e:
        return [], f"{gh[0]} could not run: {e}"
    if r.returncode:
        return [], f"{gh[0]} exited {r.returncode}: {(r.stderr.strip().splitlines() or ['no output'])[0]}"
    try:
        return [
            Pull(p["number"], p["title"], p["headRefName"], p["isDraft"], frozenset(f["path"] for f in p["files"] or ()))
            for p in json.loads(r.stdout)
        ], None
    except (ValueError, KeyError, TypeError) as e:
        return [], f"{gh[0]} printed no pull request list: {e!r}"


def git(*args: str) -> subprocess.CompletedProcess[str]:
    # A hook exports GIT_DIR, which would point every -C at the hook's own repository.
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    return subprocess.run(["git", *args], capture_output=True, text=True, env=env)


def worktrees(root: pathlib.Path) -> tuple[list[tuple[str, str, str]], str | None]:
    try:
        r = git("-C", str(root), "worktree", "list", "--porcelain")
    except OSError as e:
        return [], f"git could not run: {e}"
    if r.returncode:
        return [], f"git worktree list exited {r.returncode}: {r.stderr.strip()}"
    out = []
    for block in r.stdout.strip().split("\n\n"):
        kv = dict(line.partition(" ")[::2] for line in block.splitlines())
        if "bare" in kv or "prunable" in kv:
            continue
        s = git("-C", kv["worktree"], "status", "--porcelain")
        n = len(s.stdout.splitlines())
        mark = f"git status exited {s.returncode}" if s.returncode else f"{n} uncommitted" if n else ""
        out.append((kv["worktree"], kv.get("branch", "").removeprefix("refs/heads/"), mark))
    return out, None


def render(root: pathlib.Path, in_flight: bool, gh: Sequence[str] = GH) -> tuple[list[str], int]:
    groups = classify(load(root))
    pulls, unavailable = open_pulls(gh) if in_flight else ([], None)
    rows = [t for group in groups.values() for t, _ in group]
    name_w = max((len(t.name) for t in rows), default=0)
    shown_w = max((len(t.shown) for t in rows), default=0)
    lines = []
    for key, title in TITLES.items():
        lines.append(title)
        if not groups[key]:
            lines.append("  none")
        for t, notes in groups[key]:
            if key == "frontier":
                notes = notes + [f"in flight: {p.name}" for p in pulls if p.names(t)]
            lines.append(f"  {t.name:<{name_w}}  {t.shown:<{shown_w}}  {t.path}")
            lines += [f"  {'':<{name_w}}  {note}" for note in notes]
    if not in_flight:
        return lines, 0
    code = 0
    lines.append(f"Open pull requests in {REPO}")
    if unavailable:
        lines.append(f"  unavailable: {unavailable}")
        code = 2
    elif not pulls:
        lines.append("  none")
    lines += [f"  {p.name}  {p.branch}  {p.title}" for p in pulls]
    lines.append("Worktrees with uncommitted paths or an open pull request")
    trees, broken = worktrees(root)
    if broken:
        lines.append(f"  unavailable: {broken}")
        code = 2
    listed = 0
    for path, branch, mark in trees:
        marks = [p.name for p in pulls if branch and p.branch == branch] + ([mark] if mark else [])
        if marks:
            lines.append(f"  {path}  {branch or 'detached'}  {', '.join(marks)}")
            listed += 1
    if not listed and not broken:
        lines.append("  none")
    return lines, code


