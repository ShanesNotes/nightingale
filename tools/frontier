def selftest() -> int:
    failed: list[str] = []
    cases = 0

    def expect(case: str, ok: bool) -> None:
        nonlocal cases
        cases += 1
        if not ok:
            failed.append(case)

    def after(lines: list[str], path: str) -> str:
        i = next((i for i, line in enumerate(lines) if line.endswith(path)), len(lines))
        return lines[i + 1] if i + 1 < len(lines) else ""

    with tempfile.TemporaryDirectory() as temporary:
        root = pathlib.Path(temporary)
        for name, text in FIXTURE.items():
            f = root / ".scratch" / name.replace("/", "/issues/", 1)
            f.parent.mkdir(parents=True, exist_ok=True)
            f.write_text(text, encoding="utf-8")
        listed = {t.name: (key, notes) for key, group in classify(load(root)).items() for t, notes in group}
        for name, key, note in EXPECT:
            got = listed.get(name)
            ok = got is not None and got[0] == key and any(note in n for n in got[1] or [""])
            expect(f"{name} is {key}, noting {note!r}", ok)
        expect("no other ticket is listed", set(listed) == {name for name, _, _ in EXPECT})
        for title, name, named in NAMED:
            effort, number = name.split()
            t = Ticket(f".scratch/{effort}/issues/{number}-x.md", effort, number, "open", "", "", None)
            expect(f"{title!r} names {name}: {named}", Pull(1, title, "", False, frozenset()).names(t) == named)

        trees, broken = worktrees(root / "missing")
        expect("a failing git worktree list is reported", not trees and "exited" in (broken or ""))
        git("init", "-q", "-b", "frontier-selftest", str(root))
        lines, code = render(root, True, (sys.executable, "-c", "import sys; print(sys.argv[1])", json.dumps(PULLS)))
        expect("--in-flight exits 0", code == 0)
        expect("a title marks a 04 in flight", "in flight: nightingale#7 (draft)" in after(lines, "/04-number.md"))
        expect("a changed path marks a 07 in flight", "in flight: nightingale#7 (draft)" in after(lines, "/07-repo-path.md"))
        expect("nothing marks a 05", "in flight" not in after(lines, "/05-numbers.md"))
        expect("a 15 shows no Status line", any("no Status line" in line for line in lines if line.endswith("/15-no-status.md")))
        expect(
            "the worktree shows its pull request and uncommitted paths",
            any("frontier-selftest  nightingale#7 (draft), 1 uncommitted" in line for line in lines),
        )
        for gh in FAILING_GH:
            lines, code = render(root, True, gh)
            ok = code == 2 and any(line.startswith("  unavailable: ") for line in lines)
            ok = ok and any(line.endswith("/04-number.md") for line in lines)
            ok = ok and any("frontier-selftest  1 uncommitted" in line for line in lines)
            expect(f"gh as {gh[-1]!r} is reported unavailable and the rest still prints", ok)

    for case in failed:
        print(f"frontier: failed: {case}")
    print(f"frontier: {cases} cases, {len(failed)} failed")
    return 1 if failed else 0


def main(argv: list[str]) -> int:
    match argv:
        case [] | ["--in-flight"]:
            try:
                lines, code = render(ROOT, argv == ["--in-flight"])
            except (OSError, UnicodeDecodeError) as e:
                print(f"frontier: {e}")
                return 2
            print("\n".join(lines))
            return code
        case ["--selftest"]:
            return selftest()
        case _:
            print(__doc__, file=sys.stderr)
            return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
