#!/usr/bin/env bash
#   tools/verify [--base REV]            the merge run: the pre-merge gate and the run prove.sh records
#   tools/verify --changed [--base REV]  the changed run: the pre-push hook's checks for changed paths
#   tools/verify --full                  the full run: every step and crate, ignored tests included
#
# Exit 0 green, 1 the plan or a step failed, 64 usage.
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  echo "usage: tools/verify [--changed | --full] [--base REV]" >&2
  exit 64
}
mode=merge
base_args=()
while [ $# -gt 0 ]; do
  case "$1" in
    --changed | --full)
      [ "$mode" = merge ] || usage
      mode=${1#--}
      ;;
    --base)
      { [ $# -ge 2 ] && [ ${#base_args[@]} -eq 0 ]; } || usage
      base_args=(--base "$2")
      shift
      ;;
    *) usage ;;
  esac
  shift
done
[ "$mode" != full ] || [ ${#base_args[@]} -eq 0 ] || usage

# A command substitution, not `< <(...)`: set -e ignores a failed process substitution.
if ! plan=$(python3 -I tools/gate/gate.py plan "$mode" "${base_args[@]}"); then
  printf '%s\n' "$plan"
  echo "verify: the plan failed"
  exit 1
fi
scope='' base='' reason='' crates='' smoke='' first='' rest='' steps=''
while IFS='=' read -r key value; do
  case "$key" in
    scope | base | reason | crates | smoke | first | rest | steps) printf -v "$key" '%s' "$value" ;;
  esac
done <<<"$plan"
echo "gate: mode=$mode scope=$scope base=$base reason=$reason"
echo "gate: crates=${crates:-none} smoke=${smoke:-none}"
echo "gate: first=${first:-none}"
echo "gate: steps=$steps"
export NG_GATE_MODE="$mode" NG_GATE_SCOPE="$scope" NG_GATE_BASE="$base" NG_GATE_CRATES="$crates" NG_GATE_SMOKE="$smoke" \
  NG_GATE_FIRST="$first" NG_GATE_REST="$rest"

# The cheap steps, then the change's own mutant rows and test targets, so a red run stops near its start.
order=(01-toolchain 05-seam 10-docs 15-f64 20-sketch 30-data 40-mutants:first 10-rust 40-mutants:rest 50-workspace)
for file in tools/verify.d/*.sh; do
  case " ${order[*]%%:*} " in
    *" $(basename "$file" .sh) "*) ;;
    *) echo "verify: $file has no place in the run order"; exit 1 ;;
  esac
done
times=$(mktemp)
trap 'rm -f "$times"' EXIT
export NG_GATE_TIMES="$times"

declare -A last=() spent=()
for unit in "${order[@]}"; do last[${unit%%:*}]=$unit; done
for unit in "${order[@]}"; do
  IFS=: read -r step part <<<"$unit"
  name="$step.sh${part:+ $part}"
  case " $steps " in
    *" $step "*) ;;
    *) echo "== $name (not selected)"; continue ;;
  esac
  echo "== $name"
  start=$SECONDS
  bash "tools/verify.d/$step.sh" ${part:+"$part"} || { echo "verify: $step.sh failed"; exit 1; }
  took=$((SECONDS - start))
  spent[$step]=$((${spent[$step]:-0} + took))
  [ -z "$part" ] || echo "time: $step $part $took s" >>"$times"
  [ "${last[$step]}" != "$unit" ] || echo "time: $step ${spent[$step]} s" >>"$times"
done
cat "$times"
if [ "$mode" = changed ]; then
  echo "verify: OK for changed paths only"
else
  echo "verify: OK"
fi
